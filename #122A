import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        boolean almostLucky = false;

        // Check all possible lucky divisors up to 1000
        for (int i = 1; i <= n; i++) {
            if (isLucky(i) && n % i == 0) {
                almostLucky = true;
                break;
            }
        }

        System.out.println(almostLucky ? "YES" : "NO");

        sc.close();
    }

    static boolean isLucky(int num) {
        while (num > 0) {
            int digit = num % 10;

            if (digit != 4 && digit != 7) {
                return false;
            }

            num /= 10;
        }

        return true;
    }
}
